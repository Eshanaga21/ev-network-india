# Copy to .env. Never commit your real key or use a VITE_ prefix for secrets.
GEMINI_API_KEY=
# Your account must have access to this model; change only to a supported model.
GEMINI_MODEL=gemini-2.5-flash
# Public services for light local use. Set an empty value to disable, or supply your own instance.
EV_GEOCODER_URL=https://photon.komoot.io
EV_OSRM_URL=https://router.project-osrm.org
# Google Maps Platform: enable billing, Maps JavaScript API, Places API (New), Routes API.
# Server key: restrict to Routes/Places; never expose this key to the frontend.
GOOGLE_MAPS_API_KEY=
# Separate website-referrer-restricted key for Maps JavaScript API; intentionally used by browser.
GOOGLE_MAPS_BROWSER_KEY=
# DEMO_MAP_ID is suitable for local testing; use your own JavaScript map ID for production.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
